{
  "name": "podhigai-site",
  "version": "1.0.0",
  "scripts": {
    "start": "node scripts/serve.cjs",
    "serve": "node scripts/serve.cjs",
    "test": "node --test tests/*.test.js && npm --prefix backend test",
    "migrate": "npm --prefix backend run migrate",
    "pm2:start": "pm2 start backend/ecosystem.config.js",
